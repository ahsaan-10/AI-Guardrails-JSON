{
  // One-click tasks (Terminal > Run Task...). They call the venv's Python
  // directly, so they work whether or not the terminal is activated.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run dashboard (Streamlit)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "streamlit", "run", "app.py"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Run eval (guardrails, all models)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run_eval.py", "eval", "--engine", "guardrails", "--models", "strong,medium,weak"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Reinstall requirements",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
