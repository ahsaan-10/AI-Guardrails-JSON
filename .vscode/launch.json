{
  // Run/Debug configs (press F5, or pick one in the Run and Debug panel).
  // Each one pins the project's venv interpreter explicitly, so they work
  // even if no interpreter has been selected yet.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: dashboard (app.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "run_eval: demo (guardrails)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_eval.py",
      "args": ["demo", "--engine", "guardrails"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "run_eval: eval (guardrails, all models)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_eval.py",
      "args": ["eval", "--engine", "guardrails", "--models", "strong,medium,weak"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "run_eval: eval (builtin, all models)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_eval.py",
      "args": ["eval", "--engine", "builtin", "--models", "strong,medium,weak"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
